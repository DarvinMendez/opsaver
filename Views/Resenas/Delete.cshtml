@model opsaver.Models.Resena

@{
    ViewData["Title"] = "Eliminar reseña";
}

<h1>Eliminar reseña</h1>

<h3>¿Estás seguro de que deseas eliminar esta reseña?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Médico</dt>
    <dd class="col-sm-9">@Model.Medico?.NombreCompleto</dd>

    <dt class="col-sm-3">Paciente</dt>
    <dd class="col-sm-9">@Model.Paciente?.NombreCompleto</dd>

    <dt class="col-sm-3">Calificación</dt>
    <dd class="col-sm-9">@Model.Calificacion</dd>

    <dt class="col-sm-3">Comentario</dt>
    <dd class="col-sm-9">@Model.Comentario</dd>

    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>