@model opsaver.Models.Medico

@{
    ViewData["Title"] = "Detalles del médico";
}

<h1>Detalles del médico</h1>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre completo</dt>
        <dd class="col-sm-10">@Model.NombreCompleto</dd>

        <dt class="col-sm-2">Especialidad</dt>
        <dd class="col-sm-10">@Model.Especialidad</dd>

        <dt class="col-sm-2">Correo electrónico</dt>
        <dd class="col-sm-10">@Model.Correo</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>