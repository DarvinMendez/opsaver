@model IEnumerable<opsaver.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<h1>Pacientes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar paciente</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var paciente in Model)
        {
            <tr>
                <td>@paciente.NombreCompleto</td>
                <td>@paciente.Correo</td>
                <td>@paciente.Telefono</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@paciente.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@paciente.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@paciente.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
